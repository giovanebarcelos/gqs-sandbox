        },
        {
          "id": "8215310e-d194-4a0e-a473-4ea049107c16",
          "comment": "",
          "command": "click",
          "target": "id=login-button",
          "targets": [],
          "value": ""
        },
        {
          "id": "8f5d7d74-b46f-476b-877c-a3e7d2ffcf8e",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=[data-test=\"error\"]",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "cb43d7b2-0463-4f1c-9589-ce71628a822c",
          "comment": "teste negativo: o login deve ser recusado",
          "command": "assertText",
          "target": "css=[data-test=\"error\"]",
          "targets": [],
