      ]
    },
    {
      "id": "4e0c4f14-8265-496c-9997-555cdf0e0fc3",
      "name": "Adicionar ao carrinho",
      "commands": [
        {
          "id": "fab7f7c4-4fb8-40b8-9fa5-098eb634febb",
          "comment": "variaveis: troque aqui e o teste inteiro usa o novo valor",
          "command": "store",
          "target": "standard_user",
          "targets": [],
          "value": "usuario"
        },
        {
          "id": "0bc5724a-69c9-482a-9d4e-be359ecb547c",
          "comment": "",
          "command": "store",
          "target": "secret_sauce",
          "targets": [],
          "value": "senha"
        },
        {
          "id": "ad8da460-eb09-4b76-b4c1-434869290fc8",
          "comment": "",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "a74ae2d0-4e48-4df7-b912-6a3497d504e2",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "066a586b-162c-459b-b5db-84ecdf059404",
          "comment": "",
          "command": "type",
          "target": "id=user-name",
          "targets": [],
          "value": "${usuario}"
        },
        {
          "id": "a47c6237-695b-4843-9dd9-e68f14d5457d",
          "comment": "",
          "command": "type",
          "target": "css=[data-test=\"password\"]",
          "targets": [],
          "value": "${senha}"
        },
        {
          "id": "7a01ad80-8c66-42f8-94f0-2a3c5f503e5a",
          "comment": "",
          "command": "click",
          "target": "id=login-button",
          "targets": [],
          "value": ""
        },
        {
          "id": "7a120306-8e79-4b56-b12a-b775c6d9b96b",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=[data-test=\"inventory-list\"]",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "b5fd889a-7854-4539-ada4-5843adc55e9e",
          "comment": "guarda o nome do 1o produto",
          "command": "storeText",
          "target": "css=[data-test=\"inventory-item-name\"]",
          "targets": [],
          "value": "produto"
        },
        {
          "id": "4c591d5a-4e72-4fb7-b432-0dd87cec2df8",
          "comment": "",
          "command": "echo",
          "target": "Produto escolhido: ${produto}",
          "targets": [],
          "value": ""
        },
        {
          "id": "362f5841-baeb-4ed6-b937-4b59b3790080",
          "comment": "",
          "command": "click",
          "target": "css=[data-test^=\"add-to-cart\"]",
          "targets": [],
          "value": ""
        },
        {
          "id": "df8ac0b3-8045-4815-a5f5-cf05ead28aa8",
          "comment": "",
          "command": "assertText",
          "target": "css=[data-test=\"shopping-cart-badge\"]",
          "targets": [],
          "value": "1"
        },
        {
          "id": "a03b2f7e-177b-4083-8e1e-89234e3b64bf",
          "comment": "",
          "command": "click",
          "target": "css=[data-test=\"shopping-cart-link\"]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c3b2b304-03b6-46cd-900c-42555ec591a6",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=[data-test=\"cart-list\"]",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "2403ba4c-23f5-4232-86a6-54ddb1a3ea05",
          "comment": "o item no carrinho e o mesmo que foi adicionado",
          "command": "assertText",
          "target": "css=[data-test=\"inventory-item-name\"]",
          "targets": [],
          "value": "${produto}"
        }
      ]
