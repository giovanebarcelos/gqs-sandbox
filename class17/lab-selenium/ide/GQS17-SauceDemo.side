          "comment": "",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "c9f650e7-3a0b-4e32-a1a0-1030c68eeafb",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "dcb0edad-6fbc-4cb0-827b-fc387271feaf",
          "comment": "",
          "command": "type",
          "target": "id=user-name",
          "targets": [],
          "value": "standard_user"
        },
        {
          "id": "3c5429ef-6c15-4341-adde-c66609ac047f",
          "comment": "",
          "command": "type",
          "target": "css=[data-test=\"password\"]",
          "targets": [],
          "value": "secret_sauce"
        },
        {
          "id": "50d74fbd-bf37-438b-8be8-4b8e5e7c9397",
          "comment": "",
          "command": "click",
          "target": "id=login-button",
          "targets": [],
          "value": ""
        },
        {
          "id": "c7273c6a-d5b3-46dc-ba52-171fe65df688",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=[data-test=\"title\"]",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "eb7a54cf-fa75-4a17-b7d5-f54b3010e738",
          "comment": "oraculo: a pagina de produtos abriu",
          "command": "assertText",
          "target": "css=[data-test=\"title\"]",
          "targets": [],
          "value": "Products"
        },
        {
          "id": "d97c78f2-c62b-42fa-b66d-f92c6e800f8b",
          "comment": "",
          "command": "assertTitle",
          "target": "Swag Labs",
          "targets": [],
          "value": ""
        }
      ]
    },
    {
      "id": "f10c674d-8c29-4b64-8c53-20cc6464bb28",
