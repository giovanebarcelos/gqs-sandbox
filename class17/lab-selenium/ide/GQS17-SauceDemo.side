          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "dab73c9c-2eab-456f-bade-771ba5f70dd9",
          "comment": "",
          "command": "type",
          "target": "id=user-name",
          "targets": [],
          "value": "locked_out_user"
        },
        {
          "id": "ea3e0eff-279f-487f-9176-d5ba709dab9c",
          "comment": "",
          "command": "type",
          "target": "css=[data-test=\"password\"]",
          "targets": [],
