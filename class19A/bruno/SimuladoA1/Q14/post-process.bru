meta {
  name: Q14 - POST process
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/process
  body: json
  auth: inherit
}

body:json {
  {
    "orderId": "ORD-123",
    "qty": 2
  }
}

assert {
  res.status: eq 200
  res.body.status: eq processed
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Contrato: status e input", function () {
    expect(res.getBody()).to.have.all.keys("status", "input");
  });

  test("input devolve o payload enviado", function () {
    expect(res.getBody().input).to.deep.equal(req.getBody());
  });
}
