meta {
  name: GET books - contrato (JSON Schema)
  type: http
  seq: 4
}

get {
  url: {{baseUrlNode}}/api/books
  body: none
  auth: none
}

script:post-response {
  const Ajv = require("ajv");
  const ajv = new Ajv();

  const schema = {
    type: "object",
    required: ["books", "total"],
    properties: {
      total: { type: "integer" },
      books: {
        type: "array",
        minItems: 1,
        items: {
          type: "object",
          required: ["id", "title", "author", "available"],
          properties: {
            id: { type: "string" },
            title: { type: "string", minLength: 1 },
            author: { type: "string" },
            available: { type: "boolean" }
          }
        }
      }
    }
  };

  test("Resposta segue o contrato da API", function () {
    const valido = ajv.validate(schema, res.getBody());
    expect(valido, JSON.stringify(ajv.errors)).to.be.true;
  });
}
