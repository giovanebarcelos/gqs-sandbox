<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gqs</groupId>
    <artifactId>GQS23B01-Biblioteca</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>GQS23B01 - Biblioteca (Lab SonarQube)</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <jacoco.version>0.8.13</jacoco.version>
        <sonar.maven.version>5.1.0.4751</sonar.maven.version>

        <!-- ================================================================
             Propriedades lidas pelo SonarScanner (Aula 23B, Etapa 3).
             O host e o token vêm da linha de comando ou de variáveis de
             ambiente; NUNCA fixe o token aqui (regra S2068 — foi exatamente
             esse o defeito plantado em GQS23B01-Biblioteca.java).
             ================================================================ -->
        <sonar.projectKey>gqs-biblioteca-java</sonar.projectKey>
        <sonar.projectName>GQS23B - Biblioteca (Java)</sonar.projectName>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <!-- Caminho do XML do JaCoCo: é assim que a cobertura chega ao Sonar -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- JaCoCo: gera target/site/jacoco/jacoco.xml, consumido pelo Sonar -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SonarScanner para Maven: executa `mvn sonar:sonar` -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.maven.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
