# GQS23B - copie para `.env` (mesma pasta do docker-compose.yml) e troque a senha.
# O `.env` NAO vai para o repositorio: ja esta no .gitignore. Credencial no
# repositorio e' justamente um dos defeitos que o SonarQube aponta (S6437).
POSTGRES_PASSWORD=troque-esta-senha-antes-de-usar

# Token do endpoint /api/relatorio (cabecalho X-Admin-Token). A versao 1.0.0
# ignora esta variavel e usa o valor FIXO "relatorio-2026" escrito no codigo;
# a versao corrigida le daqui. Mantenha o mesmo valor para os testes do Bruno
# passarem nas duas versoes (ou troque aqui E no ambiente do Bruno).
TOKEN_ADMIN=relatorio-2026

# Versao exibida em /api/health. Troque para 1.0.1 depois da correcao.
# API Java (http://biblioteca.localhost)
APP_VERSION=1.0.0
# API Python (http://biblioteca-python.localhost)
APP_VERSION_PYTHON=1.0.0

# Porta do Traefik no host. Se a 80 ja estiver em uso (o lab da Aula 24,
# outro servidor web...), troque aqui e acrescente a porta na URL:
#   http://sonar.localhost:8881   http://biblioteca.localhost:8881
#HTTP_PORT=8881
