meta {
  name: 04 - Devolver livro
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/devolucoes
  body: json
  auth: none
}

body:json {
  {
    "titulo": "Clean Code"
  }
}

tests {
  test("04 - Devolver o livro emprestado retorna 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().mensagem).to.equal("Devolucao registrada: Clean Code");
  });
}
