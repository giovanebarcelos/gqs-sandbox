# GQS24 - copie para `.env` (mesma pasta do docker-compose.yml) e troque as senhas.
# O `.env` NAO vai para o repositorio: ja esta no .gitignore.
KIWI_DB_ROOT_PASSWORD=troque-esta-senha-de-root
KIWI_DB_PASSWORD=troque-esta-senha-do-usuario

# Versao exibida em /api/health. Troque para 1.0.1 depois da correcao.
# API Java (http://app.localhost)
APP_VERSION=1.0.0
# API Python (http://app-python.localhost)
APP_VERSION_PYTHON=1.0.0

# Portas do Traefik no host. Se a 80 ou a 443 ja estiverem em uso (outro
# servidor web, outro Traefik...), troque aqui e acrescente a porta na URL:
#   http://app.localhost:8880   http://app-python.localhost:8880   https://kiwi.localhost:8443
#HTTP_PORT=8880
#HTTPS_PORT=8443
