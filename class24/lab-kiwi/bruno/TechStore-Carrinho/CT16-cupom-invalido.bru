meta {
  name: CT16 - Cupom invalido
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

body:json {
  {
    "itens": [{ "produto_id": 1, "quantidade": 1 }],
    "cupom": "NATAL50"
  }
}

tests {
  test("CT16 - Cupom invalido retorna 400", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().erro).to.contain("NATAL50");
  });
}
