meta {
  name: API04 - Frete gratis em R$ 200
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/frete
  body: json
  auth: none
}

body:json {
  {"regiao": "NORDESTE", "pesoKg": 5.0, "valorPedido": 200.00}
}

tests {
  test("API04 - Pedido de exatamente R$ 200,00 tem frete gratis", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().gratis).to.equal(true);
    expect(res.getBody().frete).to.equal(0);
  });
}
