# GQS26 (Gitea) - copie para `.env` (mesma pasta do docker-compose.yml).
# O `.env` NAO vai para o repositorio: ja esta no .gitignore.

# Token que o runner usa para se registrar no Gitea. Gere um valor aleatorio
# de 40 caracteres hexadecimais com:
#   openssl rand -hex 20
RUNNER_TOKEN=troque-por-40-caracteres-hexadecimais

# Porta do Traefik no host. Se a 80 ja estiver em uso (outro servidor web,
# o lab da Aula 25 ou da Aula 26 com GitHub...), troque aqui e acrescente a
# porta nas URLs:
#   http://gitea.localhost:8886   http://boletim-staging.localhost:8886
#HTTP_PORT=8886

# Pasta com os relatorios de cobertura para o perfil "cobertura" (opcional).
# Por padrao e' ./boletim; a Etapa 3 do tutorial copia o projeto para ~/boletim.
#BOLETIM_DIR=/home/voce/boletim
